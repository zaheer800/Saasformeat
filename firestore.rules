rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Orders — customers can create and read by ID, backend handles all updates
    match /orders/{orderId} {
      allow create: if
        request.resource.data.shopId == '$(SHOP_SLUG)' &&
        isValidOrder(request.resource.data);

      // orderId is unguessable (Firestore auto-ID) — knowing it proves ownership
      allow read: if true;

      // All updates go through backend Admin SDK only
      allow update, delete: if false;
    }

    // Menu — public read, admin write only
    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Shop config — public read, admin write only
    match /shopConfig/{shopId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customers — backend Admin SDK only, no direct client access
    match /customers/{phone} {
      allow read, write: if false;
    }

    // Shop strikes — backend Admin SDK only
    match /shopStrikes/{date} {
      allow read, write: if false;
    }

    // Helper: check if the requesting user is the registered admin
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.phone_number == '$(ADMIN_PHONE)';
    }

    // Helper: basic order shape validation
    function isValidOrder(data) {
      return data.keys().hasAll(['customer', 'items', 'payment', 'status', 'shopId']) &&
             data.items.size() > 0 &&
             data.status == 'PENDING' &&
             data.payment.method in ['cod', 'upi'];
    }
  }
}
